{
  "name": "@scoresphere/sports",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@scoresphere/contracts": "workspace:*",
    "@scoresphere/engine-kit": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@scoresphere/config": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
