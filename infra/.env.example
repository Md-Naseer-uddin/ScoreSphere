# Copy to infra/.env (git-ignored). Values here are placeholders.
POSTGRES_USER=scoresphere
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://scoresphere:change-me@postgres:5432/scoresphere
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=
PUBLIC_APP_URL=https://app.scoresphere.example
CORS_ORIGINS=https://app.scoresphere.example
APP_VERSION=0.1.0
MIN_CLIENT_VERSION=0.1.0
# Optional
METRICS_TOKEN=
ERROR_WEBHOOK_URL=
LATEST_CLIENT_VERSION=
APK_URL=
APK_SHA256=
RELEASE_NOTES_URL=
